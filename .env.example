# Key inventory only. Do not copy this into .env.local.
# Set actual values in Doppler; see SECRETS.md. Never commit real credentials.

# Runtime configs: dev (local), stg (Vercel preview), prd (production).
# Agent37 has no test wallet: this key uses the operator's funded Agent37 account.
AGENT37_API_KEY=
# Optional; only needed when enabling Inkbox for an agent.
INKBOX_ADMIN_KEY=
# Use sk_test_ or rk_test_ credentials in dev/stg; live credentials only in prd.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate random value in each environment; protects /api/billing/sync.
BILLING_CRON_SECRET=
# Public Supabase settings must be Unmasked for Doppler's Vercel Dynamic sync.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Operations configs: ops_dev, ops_stg, ops_prd. Never sync these to Vercel.
SUPABASE_ACCESS_TOKEN=
# Saved by billing:setup; belongs to the selected runtime Stripe account.
STRIPE_WEBHOOK_ENDPOINT_ID=
# Optional overrides used by setup when creating/configuring Supabase.
SUPABASE_PROJECT_REF=
SUPABASE_ORG=
SUPABASE_REGION=
# Optional; protected preview webhook/scheduler access, kept in operations only.
VERCEL_AUTOMATION_BYPASS_SECRET=
