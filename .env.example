# Blank inventory. Copy runtime keys to .env.local and setup keys to .env.ops.local.
# See SECRETS.md for preview/production files. Never commit real credentials.

# Runtime files: .env.local, .env.preview.local, .env.production.local.
# Agent37 has no test wallet: this key uses the operator's funded Agent37 account.
AGENT37_API_KEY=
# Optional; only needed when enabling Inkbox for an agent.
INKBOX_ADMIN_KEY=
# Use sk_test_ or rk_test_ credentials in dev/stg; live credentials only in prd.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate random value in each environment; protects /api/billing/sync.
BILLING_CRON_SECRET=
# Public Supabase settings are bundled into the browser by Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Operations files: .env.ops.local, .env.ops.preview.local, .env.ops.production.local.
# Never upload operations files to Vercel.
SUPABASE_ACCESS_TOKEN=
# Supabase custom SMTP setup only; keep the Resend key out of runtime/Vercel.
RESEND_API_KEY=
# Address on a verified Resend domain. Name defaults to src/config/branding.ts.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
# Saved by billing:setup; belongs to the selected runtime Stripe account.
STRIPE_WEBHOOK_ENDPOINT_ID=
# Optional overrides used by setup when creating/configuring Supabase.
SUPABASE_PROJECT_REF=
SUPABASE_ORG=
SUPABASE_REGION=
# Optional; protected preview webhook/scheduler access, kept in operations only.
VERCEL_AUTOMATION_BYPASS_SECRET=
