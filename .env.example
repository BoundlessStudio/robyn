# Get it from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_replace_me

# Get it from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_replace_me

# Filled in by `npm run setup` — leave blank for a fresh free project, or paste an
# existing project's values (Project Settings -> API) to use that one instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Also filled in by `npm run setup`. Server-only (no NEXT_PUBLIC_ prefix) — never commit it
# or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared media: Commons stock discovery needs no provider key. Perflo generation
# uses AGENT37_API_KEY through an owned workstation; configure its budget in-app.

# Production only (local dev uses the browser's origin). Set your deployed URL and re-run
# `npm run setup` so Supabase allow-lists it for auth email redirects.
# NEXT_PUBLIC_SITE_URL=https://robyn.academy

# External MCP is enabled by a server-only random 32-byte base64url secret.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ROBYN_MCP_RUNTIME_SECRET=

# Optional PhotoCraft MCP App. Set after deploying the pinned editor on its
# dedicated HTTPS origin and applying the checked PhotoCraft save migration.
# ROBYN_MCP_PHOTOCRAFT_URL=https://robyn-artcraft-chat-editors.robyn-artcraft-runtime.workers.dev/mcp/photocraft/v0.17.0-0.3.2/
# Comma-separated release paths that passed the ChatGPT acceptance check.
# ROBYN_MCP_CHAT_EDITOR_ORIGIN=https://robyn-artcraft-chat-editors.robyn-artcraft-runtime.workers.dev
# ROBYN_MCP_CHAT_CRAFTS=

# Local development only: inspect an unverified adapter without enabling it for
# invited creators. Production routing uses verified application manifests.
# NEXT_PUBLIC_EDITOR_PREVIEW_APP=filmcraft
# NEXT_PUBLIC_EDITOR_PREVIEW_URL=https://your-editor-origin/filmcraft/version/?empty&fresh&norecover&robyn
