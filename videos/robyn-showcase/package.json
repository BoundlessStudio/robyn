{
  "name": "robyn-showcase",
  "version": "1.0.0",
  "description": "Robyn Creative Studio — Ideas have wings. A 60-second feature showcase.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/sync-assets.mjs",
    "score": "node scripts/compose-score.mjs",
    "qa:stills": "node scripts/qa-stills.mjs",
    "qa:mascot": "node scripts/verify-mascot.mjs",
    "render": "remotion render src/index.ts RobynShowcase out/robyn-showcase.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  },
  "overrides": {
    "zod@>=4 <4.6.6": "4.6.7"
  }
}
